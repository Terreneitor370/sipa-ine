# Base de datos
# Credenciales para conectarse a una BD local/externa (npm run db:*)
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Puerto publicado por Docker Compose en tu host (si usas db en contenedor)
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=sipa_ine
MYSQL_USER=sipa
MYSQL_PASSWORD=cambiar
# Credenciales del usuario de aplicación que crea el contenedor MySQL
MYSQL_CONTAINER_USER=sipa
MYSQL_CONTAINER_PASSWORD=cambiar
MYSQL_ROOT_PASSWORD=root

# API (Node + Express, apps/api)
API_PORT=4000
# Secreto para firmar los JWT (cadena larga y aleatoria; no compartir)
JWT_SECRET=cambiar
JWT_EXPIRES_HOURS=8
# Usuarios de la demo: definir aquí, nunca en el código ni en el repo
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
ANALISTA_NAME=Analista
ANALISTA_EMAIL=
ANALISTA_PASSWORD=
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data/processed
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_KEY=cambiar

# Servicio ML (FastAPI)
MODEL_PATH=ml/artifacts/model.json

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_USE_MOCKS=true
# Entidades con cartografía de secciones convertida (claves INE separadas por coma)
VITE_ENTIDADES_CON_GEO=26
